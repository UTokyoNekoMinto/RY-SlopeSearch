# ignore CMake generated build files
/build/
/CMakeFiles/
/CMakeCache.txt
/Makefile
/*.cmake
/*.so
/*.o
/*.a
/*.dylib
/*.dll
/*.exe

# ignore IDE generated files
*.idea/
*.vscode/
*.swp
*.swo

# ignore binary files
bin/
*.out

# ignore log files
*.log

# ignore example outputs
example/example_output/

# ignore vscode's config files
.vscode/